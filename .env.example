# ==============================================================================
# ucentral-client Environment Variables Configuration
# ==============================================================================
# These optional environment variables can be set to override default limits, 
# timeouts, and cache TTLs inside the ucentral-client process.
#
# Normally, you do not need to set any of these unless you are tuning the client
# for a constrained environment or dealing with very large payloads.
# ==============================================================================

# ------------------------------------------------------------------------------
# Payload Limits (in bytes)
# Defines the maximum allowed JSON-RPC payload size for different command types.
# ------------------------------------------------------------------------------
# OLG_PAYLOAD_LIMIT_ABSOLUTE=12582912    # Hard absolute maximum for any payload (Default: 12MB)
# OLG_PAYLOAD_LIMIT_CONFIGURE=10485760   # Max size for configure commands (Default: 10MB)
# OLG_PAYLOAD_LIMIT_SCRIPT=1048576       # Max size for script commands (Default: 1MB)
# OLG_PAYLOAD_LIMIT_CERTUPDATE=2097152   # Max size for certificate updates (Default: 2MB)
# OLG_PAYLOAD_LIMIT_DEFAULT=11534336     # Max size for standard action commands (Default: 11MB)

# ------------------------------------------------------------------------------
# Timeouts (Go duration format, e.g., "30s", "5m")
# Defines how long the client will wait for NATS dispatches or action completions.
# ------------------------------------------------------------------------------
# OLG_TIMEOUT_DISPATCH="5s"              # Max wait to initially push to NATS (Default: 5s)
# OLG_TIMEOUT_CONFIGURE="30s"            # Max wait for a configure application (Default: 30s)
# OLG_TIMEOUT_ACTION_DEFAULT="60s"       # Standard max wait for typical actions (Default: 60s)
# OLG_TIMEOUT_ACTION_EXTENDED="120s"     # Max wait for long-running actions like trace/upgrade (Default: 120s)

# ------------------------------------------------------------------------------
# Capability Cache TTLs (Go duration format)
# Defines how long capabilities retrieved from the device are cached in memory.
# ------------------------------------------------------------------------------
# OLG_CACHE_TTL_DEFAULT="2m"             # General fallback TTL
# OLG_CACHE_TTL_CONFIGURE="5m"           # Config capabilities cache
# OLG_CACHE_TTL_UPGRADE="60m"            # Firmware upgrade capabilities cache
# OLG_CACHE_TTL_FACTORY="30m"            # Factory reset capabilities
# OLG_CACHE_TTL_REBOOT="10m"             # Reboot capabilities
# OLG_CACHE_TTL_LEDS="5m"                # LED capabilities
# OLG_CACHE_TTL_REMOTE_ACCESS="10m"      # Remote access capabilities
# OLG_CACHE_TTL_SCRIPT="30m"             # Script execution capabilities
# OLG_CACHE_TTL_REENROLL="30m"           # Re-enrollment capabilities
# OLG_CACHE_TTL_CERTUPDATE="30m"         # Certificate update capabilities

# ------------------------------------------------------------------------------
# Feature / Security Overrides
# ------------------------------------------------------------------------------
# OLG_TRACE_UPLOAD_ALLOWED_URL=""        # Restricts allowed trace upload URLs
