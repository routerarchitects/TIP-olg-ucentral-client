# ==============================================================================
# OpenWiFi System E2E Tests - Configuration Example
# ==============================================================================
# Copy this file to .env and source it before running E2E tests:
#   source .env
#   go test -v ./tests/... -run TestSystemE2E
# ==============================================================================

# (Required) OpenWiFi Security & Gateway API Credentials
export OW_ADMIN_USER="root@example.com"
export OW_ADMIN_PASS="openwifi"

# (Required) Target Device Serial
export OW_DEVICE_SERIAL="001122334455"

# (Optional) OpenWiFi API Endpoints (Defaults shown)
export OW_SEC_URL="https://openwifi.wlan.local:16001"
export OW_GW_URL="https://openwifi.wlan.local:16002"

# (Optional) TLS Verification
# By default, tests verify the Gateway TLS certificates using the local ../../ca.pem
export OW_CA_FILE="../../ca.pem"
# export OW_INSECURE_TLS="true" # Set to true to bypass TLS verification entirely

# Name of the default configuration to fetch for test cleanup
OW_DEFAULT_CONFIG_NAME=default_old

# Explicitly allow destructive E2E tests (like pushing configuration to the router)
OW_ALLOW_DESTRUCTIVE_E2E=false
